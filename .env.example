# Copiez ce fichier vers .env et renseignez vos valeurs.
# PostgreSQL (exemple Neon) :
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Signature des sessions HMAC (générez : openssl rand -hex 32) — obligatoire en production
AUTH_SECRET=

# Sel du hachage RGPD des adresses IP (générez : openssl rand -hex 16)
IP_SALT=
